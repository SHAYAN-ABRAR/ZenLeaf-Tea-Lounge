# Copy this file to .env (python bootstrap.py does it for you and fills in a fresh secret key).
# One KEY=value per line. No quotes are needed, and comments must be on their own line.

# Required. A long random string that signs sessions and security tokens. Never commit it.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Keep false when you preview the site; true shows Django's detailed error pages while you develop.
DJANGO_DEBUG=false

# Hosts the site answers to, separated by commas.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Where the SQLite database file lives. Relative paths start from this folder.
ZENLEAF_DB_PATH=data/zenleaf.sqlite3

# Where python manage.py backup_db writes backups.
ZENLEAF_BACKUP_DIR=backups

# Time zone used for dates, and for checking that a table request isn't in the past.
ZENLEAF_TIME_ZONE=Asia/Dhaka

# Currency symbol shown next to prices.
ZENLEAF_CURRENCY_SYMBOL=৳

# Table requests: the hours and limits this demo accepts (settings, not real opening hours).
ZENLEAF_OPENING_TIME=10:00
ZENLEAF_LAST_SEATING=20:00
ZENLEAF_SLOT_MINUTES=30
ZENLEAF_MAX_PARTY_SIZE=8
ZENLEAF_BOOKING_DAYS_AHEAD=60
ZENLEAF_MIN_NOTICE_MINUTES=60

# Staff sign-in lockout after repeated failures.
ZENLEAF_LOGIN_MAX_ATTEMPTS=5
ZENLEAF_LOGIN_LOCKOUT_MINUTES=15

# Only for a real deployment behind HTTPS: secure cookies, HTTPS redirect and HSTS.
DJANGO_HTTPS=false
DJANGO_BEHIND_PROXY=false
DJANGO_CSRF_TRUSTED_ORIGINS=
